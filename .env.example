# ============================================================
# Kiln Technology Studio — environment template
# Copy to .env.local and fill in what you have. Everything is
# optional: the app runs with sensible development defaults.
# ============================================================

# --- Base URL (used in emails, sitemap, canonical URLs) ---
BASE_URL=http://localhost:3000

# --- Database -------------------------------------------------
# The app ships with a file-backed store (data/db.json) that
# mirrors db/schema.sql. When you move to Postgres/Supabase,
# set DATABASE_URL and swap the repositories in lib/store.ts.
DATABASE_URL=

# --- Auth -----------------------------------------------------
# Admin and demo-client credentials. In production, change these.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me
PORTAL_EMAIL=client@demo.yourdomain.com
PORTAL_PASSWORD=change-me-too
# Optional: secrets manager / session signing key for future use.
AUTH_SECRET=

# --- Email (Resend) --------------------------------------------
# Without RESEND_API_KEY, all outgoing mail is stored in the
# local outbox (visible in data/db.json) instead of delivered.
RESEND_API_KEY=
RESEND_FROM=Your Studio <hello@yourdomain.com>

# --- File storage ------------------------------------------------
# Uploads are stored locally in data/uploads/. Add provider keys
# here when moving to S3/GCS-compatible storage.
STORAGE_KEYS=

# --- AI ------------------------------------------------------------
# Reserved for connecting real LLM providers to the consultant
# and agent demos (currently rule-based, no key required).
AI_API_KEY=

# --- Analytics -----------------------------------------------------
# Server-side, cookieless analytics events are appended to
# data/analytics.jsonl. Add a provider ID if you plug one in.
ANALYTICS_ID=

# Show demo credentials on login screens (set to 1 ONLY in local dev)
# NEXT_PUBLIC_SHOW_DEMO_HINT=1
